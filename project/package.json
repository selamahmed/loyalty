{
  "name": "nexreward",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "optimize:logo": "node scripts/optimize-logo.mjs",
    "copy:critical-fonts": "node scripts/copy-critical-fonts.mjs",
    "copy:hero-assets": "node scripts/copy-hero-assets.mjs",
    "prebuild": "npm run copy:critical-fonts && npm run copy:hero-assets",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview --host 0.0.0.0 --port 5000",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check-leaderboard": "node scripts/check-leaderboard-db.mjs",
    "db:apply-leaderboard": "node scripts/apply-event-leaderboard.mjs",
    "db:apply-alltime": "node scripts/apply-alltime-leaderboard.mjs",
    "db:apply-leaderboard-signals": "node scripts/apply-leaderboard-signals.mjs"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@sentry/react": "^9.15.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.74.4",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.344.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.7",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "cors": "^2.8.6",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "express": "^5.2.1",
    "gh-pages": "^6.1.1",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "pg": "^8.21.0",
    "postcss": "^8.4.35",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^3.1.2",
    "web-push": "^3.6.7"
  }
}
