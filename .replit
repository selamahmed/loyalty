modules = ["nodejs-20", "web"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Push Notification Server"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Push Notification Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && node push-server.js"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3002

[[ports]]
localPort = 23636
externalPort = 3001

[[ports]]
localPort = 3001
externalPort = 3001

[deployment]
deploymentTarget = "static"
build = ["bash", "-c", "cd project && npm run build"]
publicDir = "project/dist"

[userenv]

[userenv.shared]
VAPID_PUBLIC_KEY = "BBy897o-OhOrQ6Rij8KzKhdIxmGnGiJEHS5jiPmvyYGY4dLzXk74iZQ0-1hUvU-WujmTsL79kM9GHPNjht2ytbM"
PUSH_PORT = "3001"
